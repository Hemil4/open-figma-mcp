{
  "name": "open-figma-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "open-figma-mcp": "server/dist/index.js",
    "figma-plugin-mcp": "server/dist/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:plugin",
    "build:server": "tsc -p server/tsconfig.json",
    "build:plugin": "esbuild plugin/src/code.ts --bundle --outfile=plugin/dist/code.js --format=iife --target=es2017",
    "dev": "tsx server/src/index.ts",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
